PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interntrack
JWT_SECRET=supersecret
REDIS_URL=redis://localhost:6379

# Only required when NODE_ENV=production — the deployed frontend origin CORS
# should allow. No trailing slash (browsers never send one in the Origin header).
CLIENT_URL=https://your-frontend-domain.com

# Password-reset and email-verification links are sent via Resend
# (https://resend.com — free tier, ~2 min to get an API key). If
# RESEND_API_KEY is unset, emails are logged to the console instead of sent,
# so the whole flow stays testable locally without an account.
#
# No quotes around EMAIL_FROM's value on Render (or any host that reads env
# vars from a dashboard field, not a .env file): dotenv strips quotes when
# parsing .env locally, but Render stores exactly what you type — quotes
# included — which Resend then rejects as an invalid `from` address.
RESEND_API_KEY=
EMAIL_FROM=TRACKr <onboarding@resend.dev>