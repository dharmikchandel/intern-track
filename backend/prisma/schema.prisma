// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  emailVerifiedAt         DateTime?
  // Shown in the app instead of the email address; optional.
  displayName             String?
  // IANA zone name (for example "Asia/Kolkata"). Decides which calendar day "today"
  // is for follow-up due dates and the weekly digest; null behaves as UTC.
  timezone                String?
  // Weekly follow-up digest. Opt-out (default on) with a one-click unsubscribe
  // link in every email; lastDigestSentAt is the idempotency guard that keeps
  // a retried or double-fired scheduler from sending twice.
  emailDigestEnabled      Boolean                  @default(true)
  lastDigestSentAt        DateTime?
  applications            Application[]
  activities              ApplicationActivity[]
  recapShares             RecapShare[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ActivityType {
  APPLICATION_CREATED
  STATUS_CHANGED
  NOTES_CHANGED
  FOLLOW_UP_CHANGED
  FOLLOW_UP_REMINDER_SENT // written by the follow-up digest job
}

model Application {
  id              String            @id @default(uuid())
  userId          String
  companyName     String
  role            String
  status          ApplicationStatus @default(APPLIED)
  appliedDate     DateTime
  applicationLink String?
  notes           String?
  followUpDate    DateTime?

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities ApplicationActivity[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  // Every read is scoped to one user, so both indexes lead with userId.
  // The second serves status-filtered lists, board columns and the
  // analytics GROUP BY (index-only scan).
  @@index([userId, appliedDate(sort: Desc)])
  @@index([userId, status, appliedDate(sort: Desc)])
}

// User-facing activity feed for an application (not a compliance audit log).
// Rows are written in the same transaction as the change they describe.
// `metadata` holds structured details (e.g. { from, to }) so the UI can build
// the sentence; free-text like notes content is deliberately never copied here.
model ApplicationActivity {
  id            String       @id @default(uuid())
  applicationId String
  userId        String
  type          ActivityType
  metadata      Json?
  createdAt     DateTime     @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Detail-page feed, newest first.
  @@index([applicationId, createdAt(sort: Desc)])
  // Cross-application questions per user (recap, milestones): "when was the
  // first STATUS_CHANGED to INTERVIEW?"
  @@index([userId, type, createdAt])
}

// A public, read-only recap link. The aggregate numbers are computed ONCE when
// the share is created and stored here as `stats`; the public endpoint only
// ever reads this row. That makes the page cheap to serve and means it is
// structurally unable to expose any per-application data: nothing but
// aggregates exists on the row. Revoking sets revokedAt and the slug stops
// resolving. `slug` is 128 bits of randomness, not derived from any id.
model RecapShare {
  id          String    @id @default(uuid())
  userId      String
  slug        String    @unique
  periodStart DateTime
  periodEnd   DateTime
  stats       Json
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
